<UserControl x:Class="Floe.Desktop.Features.Statistics.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Floe.Desktop.Controls"
             AutomationProperties.AutomationId="StatisticsPage" Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="DayBar" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Detail}" />
            <Setter Property="ToolTip" Value="{Binding Detail}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DividerBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:GlassSurface Padding="20,18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="今日专注" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TodayDuration}" Style="{StaticResource Metric}" AutomationProperties.AutomationId="StatisticsTodayDuration" /></StackPanel>
            </ui:GlassSurface>
            <ui:GlassSurface Grid.Column="1" Padding="20,18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="完成番茄" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TodayPomodoros}" Style="{StaticResource Metric}" AutomationProperties.AutomationId="StatisticsTodayPomodoros" /></StackPanel>
            </ui:GlassSurface>
            <ui:GlassSurface Grid.Column="2" Padding="20,18">
                <StackPanel><TextBlock Text="完成任务" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TodayTasks}" Style="{StaticResource Metric}" AutomationProperties.AutomationId="StatisticsTodayTasks" /></StackPanel>
            </ui:GlassSurface>
        </Grid>
        <ui:GlassSurface Padding="24,22">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="专注的节奏" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="7 天" GroupName="StatisticsPeriod" IsChecked="{Binding ShowWeek}" Style="{StaticResource ThemeOption}" Padding="12,9" AutomationProperties.AutomationId="StatisticsWeek" />
                        <RadioButton Content="30 天" GroupName="StatisticsPeriod" IsChecked="{Binding ShowMonth}" Style="{StaticResource ThemeOption}" Padding="12,9" Margin="0" AutomationProperties.AutomationId="StatisticsMonth" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource CaptionText}" Margin="0,8,0,16" AutomationProperties.AutomationId="StatisticsRange" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="期间专注" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding PeriodTotal}" Style="{StaticResource Metric}" FontSize="24" AutomationProperties.AutomationId="StatisticsPeriodTotal" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="每日平均" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding DailyAverage}" Style="{StaticResource Metric}" FontSize="24" AutomationProperties.AutomationId="StatisticsAverage" /></StackPanel>
                </Grid>
                <Grid Margin="0,16,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource CaptionText}" Margin="0,0,12,0" AutomationProperties.AutomationId="StatisticsSelectedDay" />
                    <TextBlock Grid.Column="1" Text="{Binding ScaleText}" Style="{StaticResource CaptionText}" VerticalAlignment="Bottom" />
                </Grid>
                <ListBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" ItemContainerStyle="{StaticResource DayBar}"
                         Background="Transparent" BorderThickness="0" Padding="0" Height="200" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.AutomationId="StatisticsChart" AutomationProperties.Name="每日专注柱状图，用左右方向键查看日期">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.RowDefinitions><RowDefinition Height="158" /><RowDefinition Height="24" /></Grid.RowDefinitions>
                                <Border x:Name="Bar" Height="{Binding BarHeight}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Background="{DynamicResource AccentBrush}" MaxWidth="42" />
                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasActivity}" Value="False"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource DividerBrush}" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid><TextBlock Text="{Binding AxisStart}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding AxisEnd}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" /></Grid>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" AutomationProperties.AutomationId="StatisticsEmpty" />
            </StackPanel>
        </ui:GlassSurface>
        <TextBlock Text="{Binding ScopeText}" Style="{StaticResource CaptionText}" Margin="4,14,4,0" />
    </StackPanel>
</UserControl>
