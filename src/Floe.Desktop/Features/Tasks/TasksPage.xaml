<UserControl x:Class="Floe.Desktop.Features.Tasks.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Floe.Desktop.Controls"
             AutomationProperties.AutomationId="TasksPage" Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTaskCommand}" />
    </UserControl.InputBindings>
    <StackPanel>
        <ui:GlassSurface Padding="24,20">
            <StackPanel>
                <StackPanel.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveTaskCommand}" /></StackPanel.InputBindings>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" AutomationProperties.AutomationId="TaskEditorTitle" />
                    <Button Content="新建" Command="{Binding NewTaskCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" ToolTip="新建任务（Ctrl+N）" AutomationProperties.AutomationId="TaskNew" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="任务标题" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <TextBox x:Name="TitleInput" Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TaskTitleInput}" AutomationProperties.AutomationId="TaskTitleInput" AutomationProperties.Name="任务标题，最多 120 个字符" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="预计番茄" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding DraftEstimate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" MaxLength="3" ToolTip="0 表示不设预计" AutomationProperties.AutomationId="TaskEstimateInput" AutomationProperties.Name="预计番茄，0 到 99，0 表示不设预计" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ValidationText}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="TaskValidation" />
                        <TextBlock Text="{Binding Feedback}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="TaskFeedback" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="取消" Command="{Binding CancelEditCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding CancelVisibility}" Margin="0,0,6,0" AutomationProperties.AutomationId="TaskCancel" />
                        <Button Content="{Binding SaveLabel}" Command="{Binding SaveTaskCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="TaskSave" ToolTip="保存（Enter）" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:GlassSurface>
        <Grid Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="待办" IsChecked="{Binding ShowActive}" GroupName="TaskFilter" Style="{StaticResource ThemeOption}" Padding="12,10" AutomationProperties.AutomationId="TaskFilterActive" />
                <RadioButton Content="已完成" IsChecked="{Binding ShowCompleted}" GroupName="TaskFilter" Style="{StaticResource ThemeOption}" Padding="12,10" AutomationProperties.AutomationId="TaskFilterCompleted" />
                <RadioButton Content="全部" IsChecked="{Binding ShowAll}" GroupName="TaskFilter" Style="{StaticResource ThemeOption}" Padding="12,10" AutomationProperties.AutomationId="TaskFilterAll" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" AutomationProperties.AutomationId="TaskSummary" />
        </Grid>
        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14,8" Margin="0,0,0,12" Visibility="{Binding UndoVisibility}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding UndoLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="撤销删除" Command="{Binding UndoDeleteCommand}" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="TaskUndoDelete" />
            </Grid>
        </Border>
        <ui:GlassSurface Padding="28,32" Visibility="{Binding EmptyVisibility}">
            <StackPanel><TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding EmptyHint}" Style="{StaticResource BodyText}" Margin="0,8,0,0" /></StackPanel>
        </ui:GlassSurface>
        <ListBox ItemsSource="{Binding Tasks}" Height="320" Background="Transparent" BorderThickness="0" Padding="0"
                 Visibility="{Binding ListVisibility}" ItemContainerStyle="{StaticResource TaskListItem}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.AutomationId="TaskList" AutomationProperties.Name="任务列表">
            <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVerticalScrollBar}" /></ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ui:GlassSurface Padding="16,14" CornerRadius="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Style="{StaticResource TaskCompletionCheck}" VerticalAlignment="Top"
                                      AutomationProperties.AutomationId="TaskComplete" AutomationProperties.Name="{Binding CompletionLabel}" ToolTip="{Binding CompletionLabel}" />
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TaskTitleText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="TaskProgress" />
                                    <TextBlock Text="{Binding FocusTimeText}" Style="{StaticResource CaptionText}" FontFamily="{StaticResource NumericFontFamily}" Margin="14,0,0,0" AutomationProperties.AutomationId="TaskFocusTime" ToolTip="累计专注时间" />
                                </StackPanel>
                                <TextBlock Text="{Binding PeriodText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" AutomationProperties.AutomationId="TaskPeriod" />
                                <TextBlock Text="{Binding LifecycleText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="编辑" Command="{Binding EditCommand}" Style="{StaticResource QuietButton}" Padding="9,8" AutomationProperties.AutomationId="TaskEdit" />
                                <Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource QuietButton}" Padding="9,8" AutomationProperties.AutomationId="TaskDelete" />
                            </StackPanel>
                        </Grid>
                    </ui:GlassSurface>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
