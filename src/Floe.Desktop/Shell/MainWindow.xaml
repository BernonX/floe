<Window x:Class="Floe.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Floe.Desktop.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Floe" Icon="/Assets/Floe.ico" Width="1080" Height="760" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{StaticResource UiFontFamily}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Language="zh-CN"
        ui:SurfaceProperties.MaterialsEnabled="{DynamicResource MaterialsEnabled}"
        ui:SurfaceProperties.AnimationsEnabled="{DynamicResource AnimationsEnabled}"
        AutomationProperties.AutomationId="FloeMainWindow">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="3" />
    </Window.InputBindings>
    <Grid Background="{DynamicResource ShellTintBrush}">
        <Grid IsHitTestVisible="False" ClipToBounds="True" Visibility="{DynamicResource AmbientVisibility}">
            <Ellipse Width="840" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-150,0" Fill="{DynamicResource AmbientABrush}" />
            <Ellipse Width="800" Height="650" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-300" Fill="{DynamicResource AmbientBBrush}" />
        </Grid>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseRightButtonUp="OnWindowMenu" AutomationProperties.AutomationId="WindowDragArea">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,12,5" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" AutomationProperties.AutomationId="WindowMinimize" AutomationProperties.Name="最小化" ToolTip="最小化">
                        <Path Data="M 0,5 L 10,5" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.2" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" AutomationProperties.AutomationId="WindowMaximize" AutomationProperties.Name="最大化或还原" ToolTip="最大化或还原">
                        <Path Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.1" Width="10" Height="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnClose" AutomationProperties.AutomationId="WindowClose" AutomationProperties.Name="关闭" ToolTip="关闭">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.2" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Margin="20,14,16,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="12,0,0,32">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Floe.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.AutomationId="BrandLogo" />
                        <TextBlock Text="floe" FontFamily="{StaticResource NumericFontFamily}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="专注，从容一点。" Style="{StaticResource CaptionText}" Margin="1,12,0,0" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavigationItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="主导航" AutomationProperties.AutomationId="MainNavigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Data="{Binding IconData}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="12,0,0,0">
                    <TextBlock Text="ONE THING AT A TIME" FontFamily="{StaticResource NumericFontFamily}" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="留心此刻。" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                    <TextBlock Text="Ctrl+1–4 切换页面" Style="{StaticResource CaptionText}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Margin="24,12,28,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="8,0,8,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPage.Title}" FontSize="23" FontWeight="SemiBold" AutomationProperties.AutomationId="PageTitle" />
                        <TextBlock Text="{Binding CurrentPage.Description}" Margin="0,4,0,0" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="8,0,8,12" Focusable="False" AutomationProperties.AutomationId="MainContentScroll">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVerticalScrollBar}" /></ScrollViewer.Resources>
                    <ui:TransitionContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                    AutomationProperties.AutomationId="PageContent" />
                </ScrollViewer>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
