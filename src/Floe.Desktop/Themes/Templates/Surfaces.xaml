<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Floe.Desktop.Controls">
    <Style TargetType="ui:GlassSurface">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
        <Setter Property="Padding" Value="{StaticResource SurfacePadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:GlassSurface">
                    <Grid>
                        <!-- Shadow only the surface geometry, never the text/content subtree. -->
                        <Border x:Name="Shadow" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270"
                                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource SurfaceShadowOpacity}" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Sheen" Background="{DynamicResource GlassSheenBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="InnerEdge" Margin="1" BorderBrush="{DynamicResource GlassEdgeBrush}"
                                BorderThickness="0,1,0,1" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.35"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="HoverEdge" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:SurfaceProperties.MaterialsEnabled" Value="True">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InnerEdge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Sheen" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ui:SurfaceProperties.MaterialsEnabled" Value="True">
                <Setter Property="Background" Value="{DynamicResource GlassFillBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ui:TimerDisplay">
        <Setter Property="FontSize" Value="76" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TimerDisplay">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Caption}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="{StaticResource NumericFontFamily}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" AutomationProperties.AutomationId="TimerPhase" />
                        <TextBlock Text="{TemplateBinding TimeText}" FontFamily="{StaticResource NumericFontFamily}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" FontWeight="Light" HorizontalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" AutomationProperties.AutomationId="TimerValue" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
