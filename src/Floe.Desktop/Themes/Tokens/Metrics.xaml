<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="NumericFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <CornerRadius x:Key="ControlRadius">12</CornerRadius>
    <CornerRadius x:Key="SurfaceRadius">24</CornerRadius>
    <Thickness x:Key="SurfacePadding">28</Thickness>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <Duration x:Key="FeedbackDuration">0:0:0.18</Duration>
</ResourceDictionary>
