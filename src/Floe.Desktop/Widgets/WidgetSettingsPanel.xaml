<UserControl x:Class="Floe.Desktop.Widgets.WidgetSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Floe.Desktop.Controls">
    <ui:GlassSurface>
        <StackPanel>
            <TextBlock Text="桌面组件" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="把正在进行的一件事，留在桌面。" Style="{StaticResource BodyText}" Margin="0,6,0,16" />
            <CheckBox Content="显示桌面组件" IsChecked="{Binding IsVisible}" Style="{StaticResource Switch}" AutomationProperties.AutomationId="WidgetVisible" />
            <CheckBox Content="紧凑模式" IsChecked="{Binding IsCompact}" Style="{StaticResource Switch}" AutomationProperties.AutomationId="WidgetCompact" />
            <CheckBox Content="始终置顶" IsChecked="{Binding IsTopmost}" Style="{StaticResource Switch}" AutomationProperties.AutomationId="WidgetTopmost" />
            <CheckBox Content="锁定位置" IsChecked="{Binding IsPositionLocked}" Style="{StaticResource Switch}" AutomationProperties.AutomationId="WidgetLocked" />
            <TextBlock Text="减少透明效果或高对比模式下，组件保持不透明以便阅读。" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="重置位置" Command="{Binding ResetPositionCommand}" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="WidgetResetPosition" />
            </Grid>
        </StackPanel>
    </ui:GlassSurface>
</UserControl>
