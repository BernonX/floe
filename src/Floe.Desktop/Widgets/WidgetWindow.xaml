<Window x:Class="Floe.Desktop.Widgets.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Floe.Desktop.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Floe · 桌面组件" Icon="/Assets/Floe.ico" WindowStyle="SingleBorderWindow" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Language="zh-CN"
        ui:SurfaceProperties.MaterialsEnabled="{DynamicResource MaterialsEnabled}" ui:SurfaceProperties.AnimationsEnabled="{DynamicResource AnimationsEnabled}" AutomationProperties.AutomationId="FloeWidgetWindow">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding OpenMainCommand}" />
        <KeyBinding Key="Space" Command="{Binding OpenMainCommand}" />
    </Window.InputBindings>
    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource TrayContextMenu}" ItemContainerStyle="{StaticResource TrayMenuItem}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="始终置顶" IsCheckable="True" IsChecked="{Binding IsTopmost, Mode=TwoWay}" />
            <MenuItem Header="锁定位置" IsCheckable="True" IsChecked="{Binding IsLocked, Mode=TwoWay}" />
            <MenuItem Header="隐藏组件" Command="{Binding HideCommand}" />
        </ContextMenu>
    </Window.ContextMenu>
    <ui:GlassSurface x:Name="WidgetSurface" Padding="14,10" CornerRadius="8" Cursor="Hand" ToolTip="{Binding LockHint}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Button Content="×" Command="{Binding HideCommand}" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" MinHeight="22" Padding="6,0" FontSize="14" Cursor="Arrow" ToolTip="隐藏组件" AutomationProperties.AutomationId="WidgetHide" AutomationProperties.Name="隐藏桌面组件" />
            <ContentControl x:Name="LayoutHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
        </Grid>
    </ui:GlassSurface>
</Window>
